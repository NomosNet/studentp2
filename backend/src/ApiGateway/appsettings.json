{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "SecretKey": "dev-secret-change-me-please-use-32chars",
    "Algorithm": "HS256"
  },
  "JWT_SECRET_KEY": "dev-secret-change-me-please-use-32chars",
  "JWT_ALGORITHM": "HS256",
  "REDIS_URL": "localhost:6379",
  "ReverseProxy": {
    "Routes": {
      "users": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users": {
            "Address": "http://localhost:8001/"
          }
        }
      }
    }
  }
}
